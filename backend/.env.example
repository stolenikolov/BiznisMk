# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (e.g. Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/biznismk?schema=public"

# Application
PORT=3000
NODE_ENV=development
# Comma-separated list. Vite falls back to 5174 when 5173 is busy, and
# localhost / 127.0.0.1 count as different origins to the browser.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Cookies
COOKIE_SECURE=false
