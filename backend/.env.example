# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (e.g. Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/biznismk?schema=public"

# Application
PORT=3000
# Required, no default: development, production or test.
NODE_ENV=development
# Comma-separated list. Vite falls back to 5174 when 5173 is busy, and
# localhost / 127.0.0.1 count as different origins to the browser.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# Secrets. Production refuses to start with the example values below, with
# anything shorter than 32 characters, or with two of them equal. Generate each:
#   node -p "require('crypto').randomBytes(32).toString('base64url')"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"
# Keys the stored hashes of emailed two-factor codes.
TWO_FACTOR_SECRET="change-me-two-factor-secret"

# Cookies. Must be true in production (the app is served over HTTPS there).
COOKIE_SECURE=false

# Vercel only: the bearer token Vercel Cron sends to /cron/due-reminders
# (required in production on Vercel). Locally the reminders run on a timer.
# CRON_SECRET=""
# --- bank webhooks ---
# Must equal WEBHOOK_SIGNING_SECRET in the Mock Bank API repo. The bank signs
# each webhook with it; POST /webhooks/bank refuses everything without it.
BANK_WEBHOOK_SIGNING_SECRET="dev-webhook-secret"

# The bank's own API, for paying salaries (POST /payroll/requests then
# /approve). BANK_API_KEY must equal API_KEY in the Mock Bank API repo.
# Left unset the app still receives webhooks; it just cannot start a run.
BANK_API_URL="http://localhost:4000"
BANK_API_KEY="dev-mock-bank-key"

# --- email (published schedules are emailed to employees) ---
# Leave SMTP_HOST unset in development: emails are then saved as .eml/.html
# files in backend/.mail-outbox instead of being sent. Production requires it.
# Gmail example: create an App Password (Google Account → Security → 2-Step
# Verification → App passwords) and use it as SMTP_PASS.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="your.address@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# MAIL_FROM="Your Company <your.address@gmail.com>"
